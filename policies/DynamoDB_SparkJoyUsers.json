{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowLambdaToAccessDynamoDB",
            "Effect": "Allow",
            "Action": [
                "dynamodb:GetItem",
                "dynamodb:PutItem",
                "dynamodb:UpdateItem",
                "dynamodb:DeleteItem",
                "dynamodb:Query",
                "dynamodb:Scan"
            ],            
            "Resource": [
                "arn:aws:dynamodb:*:*:table/SparkJoyUsers",
                "arn:aws:dynamodb:*:*:table/SparkJoyUsers/index/*"
            ],
            "Principal": {
                "AWS": "arn:aws:iam::*:role/Login-role-appljnt7"
            }
        }
    ]
}